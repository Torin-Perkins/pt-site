# Firebase web app config for the live portal. These values are public (they
# identify the project; security comes from Firestore rules and Auth).
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# Until these are filled in, /portal/ shows "Portal coming soon".
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-west1
